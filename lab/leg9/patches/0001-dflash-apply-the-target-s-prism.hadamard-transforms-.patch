-        ggml_tensor * col = g.build_lora_mm(output, ggml_add(ctx0, h_i, delta), output_s);
+        ggml_tensor * col = g.build_lora_mm(sh.output, dflash_head_input(ctx0, sh, ggml_add(ctx0, h_i, delta)), sh.output_s);
 

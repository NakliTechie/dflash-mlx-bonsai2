     ggml_context * ctx0 = g.ctx0;
     auto         & res  = g.res;
@@ -593,22 +668,7 @@ static void build_dfly_correction_head(llm_graph_context & g, const llama_model
     }
 
     // the target's head and embeddings when the draft ships none (shared via ctx_other)

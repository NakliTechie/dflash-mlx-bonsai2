         }
 
         ggml_tensor * h_i = ggml_cont(ctx0, ggml_view_2d(ctx0, hidden, n_embd, n_blocks,
@@ -645,7 +705,7 @@ static void build_dfly_correction_head(llm_graph_context & g, const llama_model
                 model.dfly_hc_down, NULL, NULL,

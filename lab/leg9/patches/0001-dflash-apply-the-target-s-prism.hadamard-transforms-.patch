+    cur = build_lora_mm(sh.output, dflash_head_input(ctx0, sh, cur), sh.output_s);
 
     // DFlash2 feeds these logits to the selector, so they need the target's output
     // transforms; DFlash1 and DSpark read them through the sampler instead
@@ -1213,15 +1255,8 @@ llama_model_dflash::graph_dsv4::graph_dsv4(const llama_model & model, const llm_
         return;
     }
 
-    // tok_embd from the target model (shared via ctx_other)
-    auto * tok_embd = model.tok_embd;
-    if (tok_embd == nullptr) {
-        GGML_ASSERT(cparams.ctx_other != nullptr);
-        const auto * model_other = llama_get_model(cparams.ctx_other);
-
-        GGML_ASSERT(model_other->tok_embd != nullptr && "DSpark decoder requires the target model's token embeddings");
-        tok_embd = model_other->tok_embd;
-    }
+    // tok_embd and lm_head from the target model (shared via ctx_other)
+    const dflash_shared_head sh = dflash_resolve_shared_head(model, cparams, "DSpark decoder");
 
     auto inp = std::make_unique<llm_graph_input_embd>(n_embd);
 
@@ -1230,7 +1265,7 @@ llama_model_dflash::graph_dsv4::graph_dsv4(const llama_model & model, const llm_
 
     ggml_tensor * inp_tokens = inp->tokens;
 
